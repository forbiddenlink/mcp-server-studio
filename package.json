{
  "name": "mcp-server-studio",
  "version": "1.0.0",
  "description": "Visual builder for Model Context Protocol servers - design, test, and export MCP servers with drag-and-drop",
  "author": "Liz Stein",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/forbiddenlink/mcp-server-studio"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "tools",
    "visual-builder",
    "code-generator",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "presubmit": "pnpm lint && pnpm test:run && pnpm build",
    "prepare": "husky",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "postbuild": "next-sitemap"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@arcjet/next": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/nextjs": "^10.65.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.11.2",
    "ajv": "^8.20.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "js-yaml": "^5.2.2",
    "json-schema-to-typescript": "^15.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "next-axiom": "^1.5.0",
    "next-safe-action": "^8.5.5",
    "nuqs": "^2.9.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@next/bundle-analyzer": "^16.2.10",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.5",
    "eslint": "^10",
    "eslint-config-next": "16.2.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "msw": "^2.15.0",
    "next-sitemap": "^4.2.3",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=2.0.5 <3",
      "body-parser": ">=1.20.6 <2",
      "brace-expansion": ">=5.0.8 <6",
      "esbuild": ">=0.28.1 <1",
      "fast-uri": ">=4.0.1 <5",
      "hono": ">=4.12.34 <5",
      "ip-address": ">=10.3.1 <11",
      "postcss": ">=8.5.23 <9",
      "qs": ">=6.15.2 <7",
      "sharp": ">=0.35.0 <1",
      "undici": ">=7.29.0 <8"
    }
  },
  "packageManager": "pnpm@10.32.1"
}
